{
  "manifest_version": 3,
  "name": "Tab Identity Probe",
  "version": "1.0.0",
  "description": "sessionStorage がタブ復元・破棄・再起動をまたいで生き残るかを観測するための検証専用拡張",
  "permissions": ["tabs", "sessions", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
